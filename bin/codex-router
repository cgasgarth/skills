#!/bin/zsh

set -eu

readonly config_file="$HOME/.codex/config.toml"
readonly router_url='http://127.0.0.1:2455/backend-api/codex'
readonly model_catalog_path="$HOME/.codex/model-catalog.json"
readonly service_label='com.cgas.codex-lb'
readonly service_plist="$HOME/Library/LaunchAgents/${service_label}.plist"
readonly service_target="gui/$(id -u)/${service_label}"

usage() {
  print 'Usage: codex-router <on|off|status> [--restart-app]'
  print '  on      Route new Codex sessions through codex-lb.'
  print '  off     Route new Codex sessions through your signed-in OpenAI account.'
  print '  status  Show the configured route and router service state.'
}

router_is_configured() {
  grep -Fqx "openai_base_url = \"${router_url}\"" "$config_file"
}

model_catalog_is_configured() {
  grep -Fqx "model_catalog_json = \"${model_catalog_path}\"" "$config_file"
}

service_is_loaded() {
  launchctl print "$service_target" >/dev/null 2>&1
}

write_route() {
  local mode="$1"
  local tmp_file
  tmp_file="$(mktemp "${config_file}.codex-router.XXXXXX")"
  trap 'rm -f "$tmp_file"' EXIT INT TERM

  if [[ "$mode" == 'on' ]]; then
    print -r -- "openai_base_url = \"${router_url}\"" > "$tmp_file"
  fi
  print -r -- "model_catalog_json = \"${model_catalog_path}\"" >> "$tmp_file"
  awk '!/^[[:space:]]*(openai_base_url|model_catalog_json)[[:space:]]*=/' "$config_file" >> "$tmp_file"

  chmod "$(stat -f '%Lp' "$config_file")" "$tmp_file"
  mv "$tmp_file" "$config_file"
  trap - EXIT INT TERM
}

start_router() {
  if service_is_loaded; then
    launchctl kickstart -k "$service_target"
  else
    launchctl bootstrap "gui/$(id -u)" "$service_plist"
  fi

  local attempt
  for attempt in {1..300}; do
    if nc -z 127.0.0.1 2455 >/dev/null 2>&1; then
      return 0
    fi
    sleep 0.1
  done

  print -u2 'Router service loaded, but port 2455 is not ready.'
  return 1
}

update_router() {
  print 'Checking for codex-lb updates...'
  uv tool install \
    --python 3.13 \
    --managed-python \
    --prerelease disallow \
    --upgrade \
    'codex-lb@latest'
}

stop_router() {
  if service_is_loaded; then
    launchctl bootout "$service_target"
  fi
}

restart_app() {
  local old_pid
  local new_pid
  local attempt
  old_pid="$(pgrep -x ChatGPT | head -n 1 || true)"

  if [[ -n "$old_pid" ]]; then
    /usr/bin/osascript -e 'tell application id "com.openai.codex" to quit'
    for attempt in {1..120}; do
      if ! kill -0 "$old_pid" 2>/dev/null; then
        break
      fi
      sleep 0.25
    done

    if kill -0 "$old_pid" 2>/dev/null; then
      print -u2 'ChatGPT did not exit after the quit request. It was not reopened.'
      return 1
    fi
  fi

  /usr/bin/open -a /Applications/ChatGPT.app
  for attempt in {1..120}; do
    new_pid="$(pgrep -x ChatGPT | head -n 1 || true)"
    if [[ -n "$new_pid" && "$new_pid" != "$old_pid" ]]; then
      print "ChatGPT restarted (PID ${old_pid:-none} -> ${new_pid})."
      return 0
    fi
    sleep 0.25
  done

  print -u2 'ChatGPT did not start after the launch request.'
  return 1
}

show_status() {
  local route='account'
  local service='stopped'
  router_is_configured && route='router'
  service_is_loaded && service='running'
  print "Codex route: ${route}"
  print "Router service: ${service}"
}

if (( $# < 1 || $# > 2 )); then
  usage
  exit 2
fi

readonly action="$1"
readonly restart_flag="${2:-}"
if [[ -n "$restart_flag" && "$restart_flag" != '--restart-app' ]]; then
  usage
  exit 2
fi

case "$action" in
  on)
    update_router
    start_router
    if ! router_is_configured || ! model_catalog_is_configured; then
      write_route on
    fi
    print 'Router ON. New Codex CLI sessions use codex-lb.'
    ;;
  off)
    if router_is_configured || ! model_catalog_is_configured; then
      write_route off
    fi
    stop_router
    print 'Router OFF. New Codex CLI sessions use your signed-in OpenAI account.'
    ;;
  status)
    [[ -z "$restart_flag" ]] || { usage; exit 2; }
    show_status
    exit 0
    ;;
  *)
    usage
    exit 2
    ;;
esac

if [[ "$restart_flag" == '--restart-app' ]]; then
  print 'Restarting ChatGPT to apply the route to the desktop app...'
  restart_app
else
  print 'Restart ChatGPT to apply this route to the desktop app.'
  print "Or run: codex-lb:${action} --restart-app"
fi
